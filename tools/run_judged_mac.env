# Source this on the Mac Studio before tools/run_judged.sh (2026-10-02).
#   source ~/jpwork/rg/tools/run_judged_mac.env && bash ~/jpwork/rg/tools/run_judged.sh extraction
export RG_HOME=~/jpwork/rg
export RG_PRIVATE=~/jpwork/rg_private
export RG_Q=~/jpwork/rg_private/halumem/qa_mac
export RG_EVAL=~/jpwork/rg_private/halumem/official/HaluMem/eval
export RG_PY=~/jpwork/rg/.venv-judge/bin/python
export RG_JUDGE_PY=~/jpwork/rg/.venv-judge/bin/python
export RG_MODEL=~/jpwork/rg_private/models/qwen3-14b-a8cc1361.gguf
export RG_QA_RGX=~/jpwork/rg_private/halumem/qa_rgx
export RG_QA_LLM=~/jpwork/rg_private/halumem/qa_llm
export RG_JUDGE_SUFFIX=@metal
export RG_JUDGE_CACHE_DIR=~/jpwork/rg_private/halumem/judge_cache_metal
export RG_RESULTS=~/jpwork/rg_private/halumem/official/HaluMem/eval/results
export RG_TAG=-mac
