# Source this on the Mac Studio before tools/run_judged.sh (2026-10-02).
#   source ~/rg/tools/run_judged_mac.env && bash ~/rg/tools/run_judged.sh extraction
export RG_HOME=~/rg
export RG_Q=~/rg_private/halumem/qa_mac
export RG_EVAL=~/rg_private/halumem/official/HaluMem/eval
